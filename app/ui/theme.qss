/* =========================================================
   DATASET RESEARCH
   Modern Launcher Theme
   Blue / White / Research Workspace
   ========================================================= */


/* =========================================================
   GLOBAL
   ========================================================= */

QMainWindow {
    background: #f6f8fc;
}

QWidget {
    font-family: "Segoe UI";
    font-size: 13px;
    color: #172033;
}

#appRoot {
    background: #f6f8fc;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

#sidebar {
    background: #0b1220;
    border: none;
}

#brandContainer {
    background: transparent;
    border: none;
}

#brandTitle {
    color: #ffffff;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 2px;
}

#brandAccent {
    color: #4f8cff;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 2px;
}

#brandSubtitle {
    color: #71809a;
    font-size: 10px;
    font-weight: 500;
}


/* =========================================================
   SIDEBAR SECTION LABEL
   ========================================================= */

#navSectionLabel {
    color: #52617a;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.4px;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

#navButton {
    background: transparent;
    color: #8d9ab0;

    border: none;
    border-radius: 10px;

    text-align: left;

    padding-left: 8px;
    padding-right: 8px;

    font-size: 13px;
    font-weight: 550;
}

#navButton:hover {
    background: #151f31;
    color: #dbe7ff;
}

#navButton:pressed {
    background: #19253a;
}

#navButton[active="true"] {
    background: #1a3158;
    color: #ffffff;
    font-weight: 650;
}

#navButton[active="true"]:hover {
    background: #203b68;
}

#navIcon {
    color: #64748b;
    font-size: 16px;
    font-weight: 600;
}

#navButton:hover #navIcon {
    color: #8eb5ff;
}

#navButton[active="true"] #navIcon {
    color: #62a0ff;
}

#navText {
    color: inherit;
    background: transparent;
}


/* =========================================================
   DISABLED / FUTURE FEATURES
   ========================================================= */

#navButton:disabled {
    background: transparent;
    color: #3d485b;
}

#navButton:disabled #navIcon {
    color: #394456;
}

#navButton:disabled #navText {
    color: #3d485b;
}


/* =========================================================
   WORKSPACE STATUS
   ========================================================= */

#workspaceStatus {
    background: #101a2b;

    border: 1px solid #1d2a40;
    border-radius: 10px;
}

#workspaceStatusTitle {
    color: #52617a;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
}

#workspaceStatusValue {
    color: #65d69a;
    font-size: 11px;
    font-weight: 650;
}


/* =========================================================
   SIDEBAR FOOTER
   ========================================================= */

#sidebarFooter {
    color: #4f5d73;
    font-size: 10px;
    line-height: 1.4;
}


/* =========================================================
   CONTENT CONTAINER
   ========================================================= */

#contentContainer {
    background: #f6f8fc;
    border: none;
}


/* =========================================================
   TOP BAR
   ========================================================= */

#topbar {
    background: #ffffff;

    border: none;
    border-bottom: 1px solid #e8edf5;
}

#pageTitle {
    color: #111827;

    font-size: 22px;
    font-weight: 750;
}

#topbarStatus {
    background: #eef6ff;

    color: #3977d3;

    border: 1px solid #dceaff;
    border-radius: 20px;

    padding: 7px 12px;

    font-size: 9px;
    font-weight: 750;
    letter-spacing: 0.8px;
}


/* =========================================================
   PAGE STACK
   ========================================================= */

#pageStack {
    background: #f6f8fc;
    border: none;
}


/* =========================================================
   PAGE TEXT
   ========================================================= */

#pageSubtitle {
    color: #748096;
    font-size: 13px;
}

#sectionTitle {
    color: #172033;
    font-size: 17px;
    font-weight: 700;
}


/* =========================================================
   CARDS
   ========================================================= */

#statCard,
#contentCard,
#uploadCard {
    background: #ffffff;

    border: 1px solid #e7ebf2;
    border-radius: 14px;
}


/* =========================================================
   STAT CARDS
   ========================================================= */

#statCard {
    min-height: 105px;
}

#statTitle {
    color: #7b879b;
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.5px;
}

#statValue {
    color: #152033;
    font-size: 27px;
    font-weight: 750;
}

#statDescription {
    color: #9aa5b6;
    font-size: 10px;
}


/* =========================================================
   CARD TEXT
   ========================================================= */

#cardTitle {
    color: #172033;
    font-size: 16px;
    font-weight: 700;
}

#cardDescription {
    color: #718096;
    font-size: 12px;
}


/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

#primaryButton {
    background: #397ff2;

    color: #ffffff;

    border: none;
    border-radius: 9px;

    padding: 0 20px;

    font-size: 13px;
    font-weight: 650;
}

#primaryButton:hover {
    background: #2f70dd;
}

#primaryButton:pressed {
    background: #2864c7;
}

#primaryButton:disabled {
    background: #cbd3df;
    color: #f7f8fa;
}


/* =========================================================
   SECONDARY BUTTON
   ========================================================= */

QPushButton {
    border-radius: 9px;
}

QPushButton:hover {
    background: #f0f5ff;
}

QPushButton:pressed {
    background: #e4edff;
}


/* =========================================================
   UPLOAD AREA
   ========================================================= */

#uploadIcon {
    color: #397ff2;
    font-size: 20px;
    font-weight: 800;
}

#uploadCard {
    background: #ffffff;
    border: 1px dashed #cbd9ee;
}

#uploadCard:hover {
    border: 1px dashed #397ff2;
    background: #fbfdff;
}


/* =========================================================
   PIPELINE
   ========================================================= */

#pipelineStage {
    color: #7b879b;
    font-size: 10px;
    font-weight: 650;
}


/* =========================================================
   ANALYSIS
   ========================================================= */

#analysisContent {
    color: #526070;

    background: #fbfcfe;

    font-family: "Consolas", monospace;
    font-size: 12px;

    border: 1px solid #e6eaf0;
    border-radius: 10px;

    padding: 12px;
}


/* =========================================================
   EMPTY STATE
   ========================================================= */

#emptyState {
    color: #929daf;

    background: transparent;

    font-size: 13px;

    padding: 40px;
}


/* =========================================================
   ERROR STATE
   ========================================================= */

#errorState {
    color: #b42318;

    background: #fff5f4;

    border: 1px solid #ffd5d1;
    border-radius: 10px;

    padding: 18px;
}


/* =========================================================
   TABLE
   ========================================================= */

QTableView {
    background: #ffffff;

    alternate-background-color: #f8faff;

    color: #263246;

    border: 1px solid #e5eaf1;
    border-radius: 10px;

    gridline-color: #edf0f5;

    selection-background-color: #e6f0ff;
    selection-color: #1f5fc4;
}

QTableView::item {
    padding: 7px;
    border: none;
}

QTableView::item:hover {
    background: #f3f7fd;
}

QHeaderView::section {
    background: #f7f9fc;

    color: #69768b;

    border: none;
    border-bottom: 1px solid #e5eaf1;

    padding: 9px;

    font-size: 10px;
    font-weight: 750;
}


/* =========================================================
   TABS
   ========================================================= */

QTabWidget::pane {
    background: #ffffff;

    border: 1px solid #e5eaf1;
    border-radius: 10px;
}

QTabBar::tab {
    background: transparent;

    color: #7b879b;

    border: none;

    padding: 10px 16px;

    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #397ff2;
}

QTabBar::tab:selected {
    color: #397ff2;
    font-weight: 700;

    border-bottom: 2px solid #397ff2;
}


/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox {
    background: #ffffff;

    color: #263246;

    border: 1px solid #dfe5ee;
    border-radius: 9px;

    padding: 8px 10px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #6ca1f8;
    background: #ffffff;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background: #ffffff;

    color: #263246;

    border: 1px solid #dfe5ee;
    selection-background-color: #e8f1ff;
    selection-color: #2864c7;
}


/* =========================================================
   CHECKBOX
   ========================================================= */

QCheckBox {
    color: #526070;
    spacing: 8px;
}

QCheckBox:hover {
    color: #397ff2;
}


/* =========================================================
   PROGRESS BAR
   ========================================================= */

QProgressBar {
    background: #e9eef5;

    border: none;
    border-radius: 5px;

    text-align: center;

    color: #ffffff;
    font-size: 10px;
    font-weight: 650;
}

QProgressBar::chunk {
    background: #397ff2;
    border-radius: 5px;
}


/* =========================================================
   SCROLL BAR
   ========================================================= */

QScrollBar:vertical {
    background: transparent;

    width: 8px;

    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
    background: #cbd3df;

    min-height: 35px;

    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #aeb9c9;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;

    height: 8px;

    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #cbd3df;

    min-width: 35px;

    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #aeb9c9;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background: #111827;

    color: #ffffff;

    border: 1px solid #263246;
    border-radius: 6px;

    padding: 6px 8px;

    font-size: 11px;
}


/* =========================================================
   DIVIDERS
   ========================================================= */

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #e6eaf0;
}