# Backend only. Never distribute these settings with the desktop application.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dataset_research_analytics
MYSQL_USER=dataset_events_api
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# For production, set the CA certificate path to verify the MySQL TLS server.
MYSQL_SSL_CA=
# Optional app-to-API shared secret. Use only for managed deployments; set the
# matching raw value in the desktop environment. The client sends its SHA-256.
TELEMETRY_API_TOKEN=
